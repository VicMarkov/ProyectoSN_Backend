# Copia este archivo como .env y ajusta los valores si es necesario.
PORT=3000

# PostgreSQL local (npm run db:start)
PGHOST=localhost
PGPORT=5432
PGDATABASE=sonido_vivo
PGUSER=sonido
PGPASSWORD=sonido123

# Seguridad JWT
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-larga
JWT_EXPIRES_IN=1h

# Origenes permitidos del frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Limite de intentos de login cada 15 minutos
RATE_LIMIT_MAX=50
